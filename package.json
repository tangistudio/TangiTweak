{
  "name": "tangitweak",
  "version": "0.42.0-alpha",
  "description": "Rewrite requests, responses, and pages in TypeScript.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangistudio/TangiTweak.git"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:helper": "cargo build --release --manifest-path helper/Cargo.toml",
    "test:helper": "cargo test --manifest-path helper/Cargo.toml",
    "test:e2e": "tsx test/mv3.e2e.ts",
    "test:smoke": "tsx test/smoke.e2e.ts",
    "test:e2e:samples": "tsx test/samples.e2e.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.0.280",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.3",
    "playwright-core": "^1.64.0",
    "puppeteer-core": "^24.43.1",
    "rolldown": "^1.0.0-beta.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "eslint-scope": "^9.1.2",
    "monaco-editor": "^0.57.0",
    "proxy-compare": "^3.0.1",
    "re2js": "^2.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sucrase": "^3.35.1",
    "valtio": "^2.3.2"
  },
  "engines": {
    "node": ">=24"
  }
}
