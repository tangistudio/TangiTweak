{
    "name": "TangiTweak",
    "version": "0.42.0",
    "version_name": "0.42.0-alpha",
    "description": "Rewrite requests, responses, and pages in TypeScript: redirect, edit headers, mock or transform bodies, and build page overlays.",
    "icons": {
        "16": "icons/icon-16x16.png",
        "32": "icons/icon-32x32.png",
        "48": "icons/icon-48x48.png",
        "128": "icons/icon-128x128.png"
    },
    "action": {
        "default_title": "TangiTweak",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16x16.png",
            "32": "icons/icon-32x32.png"
        }
    },
    "options_ui": {
        "page": "editor.html",
        "open_in_tab": true
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["*://*/*"],
            "js": ["hook.js"],
            "all_frames": true,
            "match_about_blank": true,
            "match_origin_as_fallback": true,
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["*://*/*"],
            "js": ["bridge.js"],
            "all_frames": true,
            "match_about_blank": true,
            "match_origin_as_fallback": true,
            "run_at": "document_start"
        }
    ],
    "permissions": [
        "storage",
        "unlimitedStorage",
        "tabs",
        "debugger",
        "offscreen",
        "webNavigation",
        "webRequest",
        "alarms",
        "proxy",
        "declarativeNetRequestWithHostAccess"
    ],
    "host_permissions": ["<all_urls>"],
    "optional_permissions": [
        "management",
        "userScripts",
        "nativeMessaging",
        "browsingData"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "hook.js",
                "overlay.html",
                "overlay.js",
                "builtins-react.js"
            ],
            "matches": ["<all_urls>"]
        }
    ],
    "sandbox": {
        "pages": ["sandbox.html", "overlay.html"]
    },
    "minimum_chrome_version": "120",
    "manifest_version": 3,
    "browser_specific_settings": {
        "gecko": {
            "id": "tangitweak@tangistudio",
            "strict_min_version": "154.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        },
        "gecko_android": {
            "strict_min_version": "154.0"
        }
    }
}
